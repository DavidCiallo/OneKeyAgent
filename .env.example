SERVER_PORT=61206

SECRET=MySecretPassphrase1234567890abcABCEFGefg
NONCE_LENGTH=8

ADMIN_NAME=Administrator
ADMIN_EMAIL=mail@example.com
ADMIN_PASSWORD=demo123@

CLIENT_URL=http://localhost:61206

ALLOWED_REGISTER_DOMAINS=example.com

# 关闭首页：/home 与未知路径跳登录页，已登录则跳该账号的默认页面（默认 1 = 开启）
# SHOW_HOME_PAGE=0

# 路由时区：供应商的生效时段与每日配额都按这个时区的自然日计算（默认 Asia/Shanghai）。
# 容器 TZ 通常是 UTC，所以别依赖系统时区 —— 填 00:00-08:00 时按这里算，不是按 UTC 算。
# ROUTING_TIMEZONE=Asia/Shanghai

# Resend API for email verification
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@example.com

TG_BOT_API_BASE_URL=https://api.telegram.org/bot856123demo

NOWPAYMENTS_API_KEY=BEGC123-ABCMF37-123MF32-123818W
IPN_CALLBACK_URL=https://ipncallback.com

# ── 多地域部署（副本节点才需要；主库留空即可）──────────────
# 设了 MAIN_DB_URL 的节点是副本：本地服务流量，启动时从主库引导一次，
# 之后把本地变更按批回传主库，并按 SYNC_PULL_SECONDS 周期性拉取主库的
# 模型/供应商/角色/设置等参考数据（余额与用量计数不会被覆盖，它们只以
# 增量回传主库）。不设则是主库，接收副本的推送。
# MAIN_DB_URL=https://main.example.com
# 与主库一致的同步密钥；为空时同步接口整体关闭
# SYNC_SECRET=change-me-to-a-long-random-string
# 便于日志区分来源
# NODE_ID=replica-overseas
# SYNC_INTERVAL_SECONDS=30
# SYNC_FLUSH_BYTES=262144
# SYNC_MAX_ROWS=500
# 从主库刷新参考数据的间隔（秒）；设为 0 关闭周期拉取
# SYNC_PULL_SECONDS=300